# Supabase (PostgreSQL)
# Copy this file to .env.local and fill in values from your Supabase project:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login at /admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Email (SendGrid or Mailchimp Transactional). Leave blank to skip sending locally.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=noreply@example.com

# Used in approval emails and admin dashboard links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test-mode keys first: pk_test_ / sk_test_ / whsec_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
