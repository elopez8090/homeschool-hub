# Supabase (PostgreSQL)
# Copy this file to .env.local and fill in values from your Supabase project:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login at /admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Resend (https://resend.com). Used for submission, claim, contact, and review emails.
# onboarding@resend.dev can only deliver to the email on your Resend account until you verify a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Christian Homeschools Hub <onboarding@resend.dev>
SUPPORT_EMAIL=support@christianhomeschoolshub.com

# Older email providers. Used only when RESEND_API_KEY is empty.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=noreply@example.com

# Used in approval emails and admin dashboard links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test-mode keys first: pk_test_ / sk_test_ / whsec_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
