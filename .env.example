# Supabase (PostgreSQL)
# Copy this file to .env.local and fill in values from your Supabase project:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard: /admin/dashboard?password=xxx
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Email (SendGrid). Leave blank to skip sending in local development.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# Used in approval emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
